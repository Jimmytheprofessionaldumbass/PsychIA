@article{AINLEY2008109,
title = {The elusive experience of ‘flow’: Qualitative and quantitative indicators},
journal = {International Journal of Educational Research},
volume = {47},
number = {2},
pages = {109-121},
year = {2008},
note = {Application of qualitative and quantitative methods to enrich understanding of emotional and motivational aspects of learning},
issn = {0883-0355},
doi = {https://doi.org/10.1016/j.ijer.2007.11.011},
url = {https://www.sciencedirect.com/science/article/pii/S0883035508000293},
author = {Mary Ainley and Laura Enger and Gregor Kennedy},
keywords = {Mixed methods, Flow, Engagement, On-task experience},
abstract = {In this investigation mixed methods were used to examine flow within the context of a writing task. Forty-four secondary students aged between 15 and 18 years completed a computer-based writing task requiring them to examine information and then write on one of two topical issues. We examined the level of agreement between end-of-task ratings based on two approaches to measuring flow, the four-channel model ratio of challenge and skill, and a classification based on ratings of absorption, timelessness and effort. Flow groups that emerged were significantly associated but not entirely consistent. A range of additional data sources concerning students’ on-task experiences illustrated different patterns of task engagement. The variability between indicators suggests that flow cannot be reliably identified through any narrow set of measures. Just as the flow experience is complex so a range of indicators is needed to identify when and how students experience flow in their learning.}
}
